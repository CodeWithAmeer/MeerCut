// Generated per executable by fa_version_resource() in apps/CMakeLists.txt: the Windows version resource (Properties >
// Details) and, for the editor, the application icon.
#include <winver.h>

@FA_RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Official GitHub: https://github.com/CodeWithAmeer"
            VALUE "CompanyName", "CodeWithAmeer"
            VALUE "FileDescription", "@FA_RC_DESCRIPTION@"
            VALUE "FileVersion", "@MEERCUT_VERSION_LABEL@"
            VALUE "InternalName", "@FA_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 CodeWithAmeer. Licensed under GPL-3.0-or-later."
            VALUE "OriginalFilename", "@FA_RC_FILE@"
            VALUE "ProductName", "MeerCut"
            VALUE "ProductVersion", "@MEERCUT_VERSION_LABEL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
