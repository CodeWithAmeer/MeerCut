# Python environments and caches
tools/.venv/
__pycache__/
*.pyc

# Large or binary files: generated or downloaded, not kept in the repository
*.mp4
*.mov
*.ts
*.wav
*.wfp
*.npz
*.npy
*.png
*.jpg
*.chm
outputs/

# Private research material is never part of the repository
research/

# Build trees live outside the repository (C:/dev/fa-build); guard against in-tree builds
editor/build*/
editor/out/
editor/vcpkg_installed/
CMakeUserPresets.json
*.partial.mp4
*.tmp

# our own application screenshots and images are documentation and are kept
!docs/screenshots/*.png
!docs/images/*.png

# M11: the sample videos ship with MeerCut (tools/make_sample_videos.py makes them; credits in CREDITS.md)
!editor/assets/samples/*.mp4

# M7 test recordings (tools/fetch_m7_testdata.py downloads them; manifest.json and transcripts.json are tracked)
testmedia/ai/**/*.flac

# Example generator working projects (absolute local paths; regenerated by tools/make_m3..m5_examples.py)
docs/examples/_projects/
